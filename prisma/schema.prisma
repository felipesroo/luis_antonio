// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Deal {
  id            String   @id @default(cuid())
  title         String
  originalPrice Float?
  discountPrice Float?
  discount      String?
  affiliateLink String?
  imageUrl      String?
  content       String?
  store         String   @default("Mercado Livre")
  clicks        Int      @default(0)
  createdAt     DateTime @default(now())

  @@map("ofertastop")
}

model CookiesConfig {
  id         Int      @id @default(autoincrement())
  platform   String   @unique
  cookie     String   @db.Text
  userAgent  String   @map("user_agent") @db.Text
  xCsrfToken String?  @map("x_csrf_token") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("cookies_config")
}

model AppConfig {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("app_config")
}

model ProdutoDisparado {
  id            String    @id @db.VarChar(255)
  name          String?   @db.Text
  title         String?   @db.Text
  originalPrice Float?    @map("original_price")
  actualPrice   Float?    @map("actual_price")
  discount      String?   @db.Text
  url           String?   @db.Text
  shortUrl      String?   @map("short_url") @db.Text
  imageUrl      String?   @map("image_url") @db.Text
  store         String?   @db.Text
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("produtos_disparados")
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @db.VarChar(100)
  discount    String    @db.VarChar(100)
  description String?   @db.Text
  store       String    @default("Todas") @db.VarChar(50) // "Todas", "Mercado Livre", "Shopee"
  dealId      String?   @map("deal_id") @db.VarChar(255)
  active      Boolean   @default(true)
  priority    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("cupons")
}



